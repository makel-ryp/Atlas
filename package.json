{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "NODE_ENV=development sh -c 'f=.env.local; [ -f \"$f\" ] || f=.env; exec node --env-file=\"$f\" --import tsx/esm server/index.ts'",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node --import tsx/esm server/index.ts",
    "seed": "sh -c 'f=.env.local; [ -f \"$f\" ] || f=.env; exec node --env-file=\"$f\" --import tsx/esm scripts/seed.ts'",
    "smoke": "sh -c 'f=.env.local; [ -f \"$f\" ] || f=.env; exec node --env-file=\"$f\" --import tsx/esm scripts/smoke.ts'"
  },
  "dependencies": {
    "@ryp/eco": "file:vendor/ryp-eco-0.21.0.tgz",
    "drizzle-orm": "^0.39.3",
    "express": "^5.0.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.0.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
