# Server-only. DATABASE_URL must be the Neon POOLER url (contains ".pooler.") for ryp-core, and
# must connect as the NOBYPASSRLS role atlas_app so the public.* policies actually bind.
DATABASE_URL=
FIREBASE_PROJECT_ID=rypstick-ios
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=       # PEM, \n-escaped. Never a VITE_ var — VITE_ vars ship to the browser.

# Client-safe Firebase config (public by design; these identify the project, they don't authorize).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=rypstick-ios
VITE_FIREBASE_AUTH_DOMAIN=
